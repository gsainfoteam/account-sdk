{
  "name": "@gsainfoteam/account-core",
  "version": "0.0.0",
  "description": "Shared core for the Infoteam account IdP: discovery, PKCE authorization, callback validation, token exchange and id_token verification",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsainfoteam/account-sdk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0",
    "jose": "^6.2.12",
    "oauth4webapi": "^3.8.8"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
