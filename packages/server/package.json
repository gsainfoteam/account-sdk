{
  "name": "@gsainfoteam/account-server",
  "version": "0.0.0",
  "description": "Backend client for the Infoteam account IdP: IdP token checks, code exchange and user lookup with client credentials",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsainfoteam/account-sdk.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@gsainfoteam/account-core": "workspace:^",
    "es-toolkit": "^1.52.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
