{
  "name": "@infoteam/account-nest",
  "version": "0.6.1",
  "description": "NestJS module for the Infoteam account IdP",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gsainfoteam/account-sdk.git",
    "directory": "packages/nest"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
