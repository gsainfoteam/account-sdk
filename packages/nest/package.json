    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^24.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@infoteam/account-core": "workspace:^",
    "@infoteam/account-server": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "zod": "^4.0.0"
  },
  "types": "./dist/index.d.ts"
