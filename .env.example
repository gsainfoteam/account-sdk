# 스테이징 IdP에 등록한 테스트 client. 이 파일을 .env로 복사해 채운다. .env는 git에 올라가지 않는다.
# mise가 .env를 읽어 test:live, example:api, example:web, example:astro에 넣어 준다.
ACCOUNT_TEST_CLIENT_ID=
ACCOUNT_TEST_CLIENT_SECRET=
# examples/web은 VITE_ 접두사가 붙은 값만 읽으므로 같은 client id를 한 번 더 넣는다.
VITE_ACCOUNT_CLIENT_ID=
# examples/nest가 허용하는 프론트 origin. 생략하면 examples/web의 http://localhost:5173이다.
# examples/astro로 확인할 때는 http://localhost:5174로 바꾼다.
# WEB_ORIGIN=http://localhost:5174
